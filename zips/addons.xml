<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="service.watchparty" name="Watch Party" version="0.2.5" provider-name="Watch Party">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Synchronised Plex playback with friends in PM4K</summary>
        <description lang="en_GB">Watch Party synchronises Plex playback in PM4K across devices, so friends in different places can watch together. Start a watch party and invite people: playback starts, pauses and skips for everyone at the same time. Requires a Watch Party server and a connection code from its administrator.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="repository.watchparty" name="Watch Party Repository" version="1.0.0" provider-name="Watch Party">
    <extension point="xbmc.addon.repository" name="Watch Party Repository">
        <dir>
            <info compressed="false">https://berserker-git.github.io/watchparty-kodi/zips/addons.xml</info>
            <checksum>https://berserker-git.github.io/watchparty-kodi/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://berserker-git.github.io/watchparty-kodi/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Updates for Watch Party</summary>
        <description lang="en_GB">Install this once. Kodi then keeps Watch Party up to date by itself.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
